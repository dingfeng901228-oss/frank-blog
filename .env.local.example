# Cloudflare R2 credentials for pre-commit hook (scripts/r2-pre-commit.mjs)
#
# Setup:
#   1. CF Dashboard → R2 → Manage R2 API Tokens → Create API Token
#   2. Token name: frank-blog-r2-hook (or whatever you like)
#   3. Permissions: Object Read & Write
#   4. Specify bucket(s): frank-blog-assets (NOT "All buckets")
#   5. TTL: leave empty
#   6. Create → copy Access Key ID + Secret Access Key
#   7. Rename this file to .env.local and paste your real values
#   8. Verify .env.local is in .gitignore (Next.js convention: should be by default)

R2_ACCOUNT_ID=your-32-hex-cf-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ============================================================
# CMS secrets (Phase 1+ — copy these to .env.local when needed)
# ============================================================
# Each secret also must be set on the CF Pages project via:
#   wrangler pages secret put <NAME> --project-name=frank-blog-cms
#
# ADMIN_PASSWORD
#   admin@frank2025.com 登录密码 (≥12 chars)
#   scripts/seed-admin.mjs reads this to seed the admin user
#   used once during Phase 1 setup, can be rotated by re-running the script
#   NEVER log this value, NEVER commit
ADMIN_PASSWORD=

# SESSION_SECRET
#   Random 64-char hex string for cookie signing (Phase 3)
#   Generate: openssl rand -hex 64
#   NEVER commit
SESSION_SECRET=

# CLOUDFLARE_DEPLOY_HOOK_URL
#   CF Pages Deploy Hook URL (Settings → Builds → Create hook)
#   CMS publishes trigger this URL → SSG rebuild (ADR-002)
#   Example: https://api.cloudflare.com/client/v4/pages/webhooks/deploy-hooks/<UUID>
#   NEVER commit
CLOUDFLARE_DEPLOY_HOOK_URL=
